    "crypto-js": "^4.1.1",
    "dayjs": "^1.10.6",
    "element-ui": "^2.15.6",
    "js-cookie": "^2.2.0",
    "mockjs": "^1.0.1-beta3",
    "nprogress": "^0.2.0",
    "regenerator-runtime": "^0.14.1",
    "script-loader": "^0.7.2",
    "sortablejs": "^1.10.0-rc2",
    "vue": "2.6.14",
    "vue-axios": "^2.1.2",

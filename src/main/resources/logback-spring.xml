<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<conversionRule conversionWord="levelColor" class="com.haruhi.botserver.infrastructure.logging.LevelColorCustomConfig"/>
	<conversionRule conversionWord="messageColor" class="com.haruhi.botserver.infrastructure.logging.MessageColorCustomConfig"/>
	<!-- DbLog 在 lambda 里调用 slf4j，%C/%M 会打印成 DbLog.lambda$xxx$n，这里改为取真实调用方：优先 MDC，其次调用栈 -->
	<conversionRule conversionWord="logClass" class="com.haruhi.botserver.infrastructure.logging.LogClassConverter"/>
	<conversionRule conversionWord="logMethod" class="com.haruhi.botserver.infrastructure.logging.LogMethodConverter"/>
	
	
	<!-- 输出到控制台的日志配置 -->
	<appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<!--格式化输出，详细请参考log4j API -->
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %levelColor(%p) [%thread] %logClass.%logMethod: %messageColor(%m%n)</pattern>
		</encoder>
	</appender>

	<!-- 所有日志 -->
	<appender name="rollingFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/haruhibot.log</file>

		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!-- 日志文件备份的文件名 -->
			<FileNamePattern>logs/haruhibot_%d{yyyy-MM-dd}_%i.log</FileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %p [%thread] %logClass.%logMethod: %m%n</pattern>
		</encoder>
	</appender>

	<!-- 业务数据库日志：只有 DbLog 打出的 DB_LOG Marker 日志才会入库 -->
	<appender name="databaseAppender" class="com.haruhi.botserver.infrastructure.logging.DatabaseLogAppender">
		<queueSize>5000</queueSize>
		<maxMessageLength>4000</maxMessageLength>
		<maxThrowableLength>8000</maxThrowableLength>
		<discardInfoWhenQueueFull>true</discardInfoWhenQueueFull>
	</appender>

	<root level="info">
		<appender-ref ref="rollingFileAppender" />
		<appender-ref ref="consoleAppender" />
		<appender-ref ref="databaseAppender" />
	</root>
</configuration>
